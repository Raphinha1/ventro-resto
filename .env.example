# Local demonstration template only. Fill blank secrets before starting.
# Never use these values for a shared or production deployment.
POSTGRES_DB=ventro_local
DB_URL=jdbc:postgresql://db:5432/ventro_local
DB_USER=ventro_local
DB_PASSWORD=
PORT=8080
THYMELEAF_CACHE=false

# Must be valid UUIDs. The application seeds deployment_identity on first boot;
# later starts must use the same pair as that database row.
VENTRO_RESTAURANT_ID=00000000-0000-4000-8000-000000000001
VENTRO_BRANCH_ID=00000000-0000-4000-8000-000000000002

# Required by the attendance PIN codec. Generate a unique Base64 value from
# at least 32 random bytes; never reuse an example or commit the real value.
VENTRO_ATTENDANCE_PIN_PEPPER=

# Required only on the first start against an empty database.
VENTRO_BOOTSTRAP_ADMIN_USERNAME=local_admin
VENTRO_BOOTSTRAP_ADMIN_PASSWORD=

# Optional. Leave blank to keep new receipt confirmation disabled.
VENTRO_INVENTORY_CURRENCY=
VENTRO_RESERVAS_VENTANA_BLOQUEO_MINUTOS=30

# Local bind mount used by the Compose example; not a private host path.
UPLOADS_HOST_DIR=./runtime/uploads
